{
  "all": true,
  "include": ["extensions/**/*.ts"],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "test/**",
    "node_modules/**",
    "coverage/**",
    "scripts/**"
  ],
  "reporter": ["text", "html", "lcov"],
  "check-coverage": false,
  "lines": 80,
  "functions": 80,
  "branches": 80,
  "statements": 80
}
