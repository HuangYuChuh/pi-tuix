{
  "name": "pi-tuix",
  "version": "0.1.0",
  "description": "Open source terminal UI extension for Pi Coding Agent with a clearer Claude Code-inspired workflow.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuangYuChuh/pi-tuix.git"
  },
  "homepage": "https://github.com/HuangYuChuh/pi-tuix#readme",
  "bugs": {
    "url": "https://github.com/HuangYuChuh/pi-tuix/issues"
  },
  "files": [
    "extensions/",
    "themes/",
    "README*.md",
    "llms.txt",
    "LICENSE"
  ],
  "keywords": [
    "pi-tuix",
    "pi-coding-agent",
    "pi-extension",
    "pi-tui",
    "terminal-ui",
    "tui",
    "terminal",
    "coding-agent",
    "developer-tools",
    "open-source",
    "claude-code-alternative",
    "command-line",
    "typescript",
    "nodejs",
    "ai-coding"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "node --test test/**/*.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=lcov npm test",
    "test:watch": "node --test --watch test/**/*.test.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:check": "node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": ">=0.84.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^26.2.0",
    "c8": "^12.0.0",
    "typescript": "^7.0.2"
  }
}
